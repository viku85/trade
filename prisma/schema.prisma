datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "./prisma/client"
}

model Rule {
  id          Int            @id @default(autoincrement())
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  type        String         // e.g., 'static', 'api'
  condition   Json           // JSON to store rule conditions
  user        User           @relation(fields: [userId], references: [id], name: "RuleToUser")
  userId      Int
  RulePurchase RulePurchase[]
}

model RulePurchase {
  id        Int      @id @default(autoincrement())
  rule      Rule     @relation(fields: [ruleId], references: [id])
  ruleId    Int
  purchase Purchase @relation(fields: [purchaseId], references: [id])
  purchaseId Int
  user      User     @relation(fields: [userId], references: [id], name: "RulePurchaseToUser")
  userId    Int
}

model User {
  id        Int        @id @default(autoincrement())
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  email     String     @unique
  name      String?
  purchases Purchase[]
  RuleToUser Rule[] @relation("RuleToUser")
  RulePurchaseToUser RulePurchase[] @relation("RulePurchaseToUser")
  sales     Sale[]
}

model Purchase {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  amount    Float
  asset     String
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  RulePurchase RulePurchase[]
}

model Sale {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  amount    Float
  asset     String
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
}